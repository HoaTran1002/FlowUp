# FlowUp — environment contract (docs/phase-1/README.md §7)
# Committed with PLACEHOLDER, NON-SECRET values only. Copy to .env and fill in locally.
# .env is never committed (AGENTS.md INV-08).

# ---------------------------------------------------------------------------
# All processes
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# api, dispatcher, worker — PostgreSQL (secret-bearing: never logged)
# Pool is sized per process; see TECHNICAL_DESIGN.md §10.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://flowup:flowup_local_password@localhost:5432/flowup?schema=public
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# api, dispatcher, worker — Redis / BullMQ (secret-bearing: never logged)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# api
# ---------------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
# ADR-04 pending: pilot proposal is 256 KiB (SYSTEM_ARCHITECTURE.md §8).
PUBLISH_MAX_BODY_BYTES=262144

# ---------------------------------------------------------------------------
# api, worker — master key for endpoint signing secrets (BE-06)
# Phase 1 validates presence and decoded length only; it is NOT used yet.
# Must be 32 bytes, base64-encoded. Generate locally, never commit a real value.
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---------------------------------------------------------------------------
# dispatcher (BE-08)
# ---------------------------------------------------------------------------
DISPATCHER_POLL_INTERVAL_MS=1000
DISPATCHER_PROBE_PORT=3001

# ---------------------------------------------------------------------------
# worker (BE-09, BE-10) — ADR-04 pending: values below are the documented
# pilot proposals from SYSTEM_ARCHITECTURE.md §8, carried as configuration.
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_PROBE_PORT=3002
DELIVERY_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_BASE_MS=5000
DELIVERY_MAX_AGE_MS=86400000
DELIVERY_MAX_RESPONSE_BYTES=65536

# ---------------------------------------------------------------------------
# web (FE-01) — build-time only, not a secret
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Docker Compose only (infrastructure/docker-compose.yml) — local credentials.
# Not read by any application process.
# ---------------------------------------------------------------------------
POSTGRES_USER=flowup
POSTGRES_PASSWORD=flowup_local_password
POSTGRES_DB=flowup
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=8080
