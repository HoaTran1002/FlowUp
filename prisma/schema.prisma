// FlowUp — centralized Prisma schema.
//
// TECHNICAL_DESIGN.md §2: migrations are centralized in one location, not
// generated independently per executable. apps/api, apps/dispatcher and
// apps/worker all consume the single client generated from this file.
//
// Prisma 7 no longer accepts `datasource.url` in the schema. The migration
// connection string is resolved in `prisma.config.ts`; the runtime connection
// is supplied by the `@prisma/adapter-pg` driver adapter in
// `packages/config/src/prisma`, which is also where DATABASE_POOL_SIZE is
// applied per process (TECHNICAL_DESIGN.md §10).
//
// Phase 1 (BE-01) deliberately contains NO business model. The organization,
// user, membership, application, api key, endpoint, subscription, event,
// delivery, attempt, outbox and audit tables are BE-03, which follows the
// migration sequence in DATABASE_DESIGN.md §8. Do not pre-create them here.

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

/// Infrastructure-only table. It exists to prove the migration pipeline and to
/// give readiness a cheap authoritative round-trip against the business
/// database. It carries no business state and no tenant data.
model SchemaMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_metadata")
}
